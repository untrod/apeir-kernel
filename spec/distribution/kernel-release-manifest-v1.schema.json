{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nous:kernel:release-manifest:v1",
  "title": "Nous Kernel Release Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "version", "target", "profile", "generated_at", "source", "protocols", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "product": {"const": "nous-kernel"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"},
    "target": {"type": "string", "minLength": 1},
    "profile": {"const": "release"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["revision", "dirty"],
      "properties": {
        "revision": {"type": "string", "minLength": 1},
        "dirty": {"type": "boolean"}
      }
    },
    "protocols": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nki", "provider_contract"],
      "properties": {
        "nki": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "current"],
          "properties": {
            "minimum": {"type": "integer", "minimum": 1},
            "current": {"type": "integer", "minimum": 1}
          }
        },
        "provider_contract": {
          "type": "object",
          "additionalProperties": false,
          "required": ["major"],
          "properties": {"major": {"type": "integer", "minimum": 1}}
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "name", "sha256", "size_bytes"],
        "properties": {
          "role": {"enum": ["daemon", "provider-worker", "cli"]},
          "name": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 1}
        }
      }
    }
  }
}
