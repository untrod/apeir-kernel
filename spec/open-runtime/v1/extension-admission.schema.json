{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionAdmissionRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extension_id",
    "version",
    "content_digest",
    "source_format",
    "compatibility_level",
    "kinds",
    "capability_requests",
    "executor",
    "metadata"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "extension_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_format": {"type": "string", "minLength": 1},
    "compatibility_level": {"type": "integer", "minimum": 0, "maximum": 5},
    "kinds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["skill", "tool", "plugin", "provider", "agent", "template", "pack"]}
    },
    "capability_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "access", "scope", "reason", "required"],
        "properties": {
          "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"},
          "access": {"enum": ["read", "write", "execute", "connect", "use"]},
          "scope": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string"},
          "required": {"type": "boolean"}
        }
      }
    },
    "executor": {"type": "string"},
    "metadata": {
      "type": "object",
      "required": [
        "authority",
        "supply_chain_verified",
        "normalized_ir_digest",
        "sbom_digest",
        "provenance_digest",
        "signature_status",
        "signature_digest"
      ],
      "properties": {
        "authority": {"const": "none"},
        "supply_chain_verified": {"const": "true"},
        "normalized_ir_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "sbom_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "provenance_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "signature_status": {"enum": ["Unsigned", "Verified"]},
        "signature_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      },
      "additionalProperties": {"type": "string"}
    }
  }
}
