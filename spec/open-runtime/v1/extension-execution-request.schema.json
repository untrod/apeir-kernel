{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtensionExecutionRequest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "extension_id", "content_digest", "authorization_receipt_id", "capability", "operation", "parameter_hash", "executor", "scope"],
  "properties": {
    "schema_version": {"const": 1},
    "operation_id": {"type": "string", "minLength": 1},
    "extension_id": {"type": "string", "minLength": 1},
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "authorization_receipt_id": {"type": "string", "minLength": 1},
    "capability": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z0-9_-]+)+$"},
    "operation": {"type": "string", "minLength": 1},
    "parameter_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "executor": {"type": "string"},
    "scope": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }
}
